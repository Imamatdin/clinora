# Local development template only; never use these examples as production credentials.
PORT=3001
APP_ORIGIN=http://127.0.0.1:3001
COOKIE_SECURE=false
NODE_ENV=development
# Set both to a password you choose; URL-encode it in DATABASE_URL.
# POSTGRES_PASSWORD=your_local_only_password
# DATABASE_URL=postgresql://clinora:your_local_only_password@127.0.0.1:54328/clinora_local
# TEST_DATABASE_URL must explicitly name a dedicated /clinora_test database.
# Never reuse production DATABASE_URL for tests.
# No VITE_ variables, provider credentials or external services are needed.
