{
  "name": "clinora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "db:migrate": "node --import tsx scripts/database.mjs migrate",
    "db:bootstrap": "node --import tsx scripts/database.mjs bootstrap",
    "db:demo": "node --import tsx scripts/demo.mjs",
    "start": "node dist/server/server/main.js",
    "test:built": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:built && npm run test:browser",
    "telegram:setup": "node --import tsx scripts/telegram-setup.mjs",
    "icons": "node scripts/render-icons.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "8.3.8"
  }
}
