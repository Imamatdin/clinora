{
  "name": "clinora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/server/server/main.js",
    "test:built": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:built"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "8.3.8"
  }
}
